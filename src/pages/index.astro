---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home | Naga">
	<section class="hero-section relative overflow-hidden py-24">
		<div class="container mx-auto px-4 text-center">
			<p class="text-sm uppercase tracking-[0.3em] text-slate-500 dark:text-slate-400 mb-4">Portfolio of an AI-driven software engineer</p>
			<h1 class="hero-heading text-4xl md:text-6xl font-bold mb-6 max-w-4xl mx-auto">
				Senior Full-Stack & Agentic AI Engineer
			</h1>
			<p class="hero-copy mx-auto max-w-2xl text-base md:text-lg leading-8 mb-10">
				Building responsive web platforms and intelligent systems with clean code, thoughtful design, and modern tooling.
			</p>
			<div class="flex flex-col gap-4 sm:flex-row sm:justify-center sm:gap-6">
				<a href="/projects" class="inline-flex justify-center items-center bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-full font-semibold transition">
					View Projects
				</a>
				<a href="/blog" class="hero-cta-secondary inline-flex justify-center items-center px-6 py-3 rounded-full font-semibold transition">
					Read Blog
				</a>
			</div>
		</div>
	</section>
</Layout>
