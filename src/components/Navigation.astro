---
const currentPath = Astro.url.pathname;
---

<nav class="nav-surface p-4">
	<div class="container mx-auto flex justify-between items-center">
		<a href="/" class="nav-brand text-xl font-bold">Naga</a>
		<ul class="flex items-center space-x-4">
			<li><a href="/" class={`nav-link hover:text-blue-500 ${currentPath === '/' ? 'text-blue-400' : ''}`}>Home</a></li>
			<li><a href="/blog" class={`nav-link hover:text-blue-500 ${currentPath.startsWith('/blog') ? 'text-blue-400' : ''}`}>Blog</a></li>
			<li><a href="/contact" class={`nav-link hover:text-blue-500 ${currentPath === '/contact' ? 'text-blue-400' : ''}`}>Contact</a></li>
		</ul>
	</div>
</nav>
	</nav>